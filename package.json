{
  "name": "da-portfolio-v4",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "cv:pdf": "node scripts/export-cvs.mjs",
    "cv:setup": "playwright-core install chromium",
    "cv:check": "node scripts/check-cv-pdf.mjs",
    "dev": "next dev",
    "build": "next build",
    "build:worker": "cross-env GITHUB_GRAPHQL_TOKEN= GITHUB_TOKEN= opennextjs-cloudflare build",
    "preview": "npm run build:worker && opennextjs-cloudflare preview",
    "deploy": "npm run build:worker && opennextjs-cloudflare deploy",
    "upload": "npm run build:worker && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build:worker"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "gsap": "^3.15.1",
    "next": "^16.4.5",
    "ogl": "^1.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@opennextjs/cloudflare": "^1.20.16",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.5.438",
    "playwright-core": "1.64.1",
    "prettier": "^3.9.10",
    "raw-loader": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7",
    "wrangler": "^4.129.0"
  }
}
